{
  "name": "seedling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json --ignore ./data --ignore ./.next server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx --tsconfig tsconfig.json server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@libsql/client": "^0.18.0",
    "@monaco-editor/react": "^4.7.0",
    "@next/env": "16.3.6",
    "@phosphor-icons/react": "2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.1",
    "better-auth": "^1.7.7",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "motion": "12.23.12",
    "next": "16.3.6",
    "nodemailer": "^10.0.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "type": "module",
  "packageManager": "pnpm@10.28.1"
}
